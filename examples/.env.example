# Harbormaster environment variables
# Copy this file to .env and fill in real values, OR set these as Windows
# environment variables (recommended for production).

# === Discord webhooks ===
# Create webhooks via your Discord server's Integrations settings.
# Use separate channels for different severities.
WINDROSE_WEBHOOK_ALERTS=https://discord.com/api/webhooks/...
WINDROSE_WEBHOOK_STATUS=https://discord.com/api/webhooks/...
WINDROSE_WEBHOOK_HEARTBEAT=https://discord.com/api/webhooks/...

# === Healthchecks.io ===
# Create checks at https://healthchecks.io and paste the ping URLs here.
# The "_WEEKDAY" / "_WEEKEND" split is needed for tasks that run on
# different schedules different days.
WINDROSE_HC_BACKUP=https://hc-ping.com/...
WINDROSE_HC_UPDATE_CHECK_WEEKDAY=https://hc-ping.com/...
WINDROSE_HC_UPDATE_CHECK_WEEKEND=https://hc-ping.com/...
WINDROSE_HC_HEALTH_WEEKDAY=https://hc-ping.com/...
WINDROSE_HC_HEALTH_WEEKEND=https://hc-ping.com/...